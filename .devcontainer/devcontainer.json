{
  "name": "Incident Triage Dev (Storage-Safe)",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bullseye",
  "features": {
    // ONLY Microsoft-hosted features (no ghcr.io permission issues)
    "docker-outside-of-docker": "latest"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "hashicorp.terraform",
        "amazonwebservices.aws-toolkit-vscode",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.exclude": {
          "**/.git": true,
          "**/.DS_Store": true,
          "**/*.pyc": true,
          "**/__pycache__": true,
          "**/.venv": true,
          "**/node_modules": true,
          "**/data": true,
          "**/models": true,
          "**/faiss_index": true
        }
      }
    }
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "AWS_REGION": "us-east-1",
    "PROJECT_HOME": "/workspaces/incident-triage-aws",
    "PIP_USER": "true",
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.local"
  },
  // CRITICAL: Manual tool installation (avoids ghcr.io permission errors)
  "postCreateCommand": "bash -c '.devcontainer/setup.sh'",
  // ENFORCE storage safety on EVERY terminal open
  "postStartCommand": "bash -c 'du -sh /workspaces 2>/dev/null | awk \"{if (\\$1+0 > 500) print \\\"⚠️ WARNING: Storage > 500MB! Run: cleanup-storage\\\"}\"'",
  "waitFor": "postCreateCommand",
  "mounts": [
    // Mount cache directories to persistent Codespaces cache (survives rebuilds)
    "source=codespaces-python-cache,target=/home/vscode/.cache/pip,type=volume",
    "source=codespaces-npm-cache,target=/home/vscode/.npm,type=volume"
  ],
  "securityOptions": {
    "seccompProfile": "unconfined"
  }
}
