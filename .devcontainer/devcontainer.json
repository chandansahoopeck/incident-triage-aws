{
  "name": "Python, Go, AWS, Terraform Dev Container (Stable)",
  // Use a specific, stable Debian release (bullseye) to avoid potential repo issues
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bullseye", 
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/aws-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest"
    },
    // Explicitly add Docker-in-Docker or Docker-outside-of-Docker feature
    // Using docker-outside-of-docker as it's generally more reliable in Codespaces
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "moby": true // Install Moby (Docker's open source engine)
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "golang.go",
        "hashicorp.terraform",
        "amazonwebservices.aws-toolkit-vscode",
        "ms-azuretools.vscode-docker" // Useful Docker extension
      ]
    }
  },
  // Optional: Run commands after the container is created
  "postCreateCommand": "pip install --upgrade pip && go version && aws --version && terraform version"
}
